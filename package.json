{
  "name": "hyphos",
  "version": "0.4.0",
  "description": "Rewrite any AI draft so it reads as written by you — register-aware voice profiles built from your own writing, with deterministic quirk enforcement and a fidelity score.",
  "type": "module",
  "bin": {
    "hyphos": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build",
    "prepublishOnly": "./scripts/artifact-check.sh",
    "changeset": "changeset",
    "version:packages": "changeset version"
  },
  "keywords": [
    "writing",
    "voice",
    "stylometry",
    "rewrite",
    "personal-voice",
    "local-first"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fleetorders/hyphos.git"
  },
  "homepage": "https://github.com/fleetorders/hyphos#readme",
  "bugs": {
    "url": "https://github.com/fleetorders/hyphos/issues"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "adm-zip": "0.6.0",
    "commander": "12.1.0",
    "mailparser": "3.9.15",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/mailparser": "3.4.6",
    "@types/node": "22.10.2",
    "prettier": "3.4.2",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "5.7.2",
    "vitest": "4.1.10"
  }
}
